# Trading AI Terminal — environment template
# Copy to .env and edit.

# Broker: deriv | oanda | yahoo
FX_BROKER=deriv

# DERIV (Options account; forex + gold live on a single account) —
# https://api.deriv.com token + app id + account id
DERIV_TOKEN=
DERIV_APP_ID=
DERIV_ACCOUNT_ID=

# OANDA (forex / gold) — optional backup feed.
# Token: log in at oanda.com → My Account → Manage API Access → Generate Token.
# Account ID: shown in your OANDA dashboard (e.g. 101-004-1234567-001).
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
# true = api-fxpractice.oanda.com (Global Markets Demo) / false = api-fxtrade.oanda.com
OANDA_PRACTICE=true

# AI / Ollama — run `ollama serve` and `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Trading
DEFAULT_ASSET=EUR_USD
# paper | live
TRADING_MODE=paper
FOREX_ENABLED=true
GOLD_ENABLED=true
DEFAULT_ENGINE=forex
INTERVAL_SECONDS=5
DEFAULT_TIMEFRAME=5m

# Asset universe (comma separated)
FOREX_ASSETS=EUR_USD,GBP_USD,USD_JPY
GOLD_ASSETS=XAU_USD

# Risk
MAX_DAILY_LOSS=5.0
MAX_CONSECUTIVE_LOSSES=5
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE_PCT=0.5

# Paths (relative to the working directory)
DATA_DIR=data
LOG_DIR=logs